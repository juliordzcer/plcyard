  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "MainRoutine",
      "language": "ST",
      "source": "(* Tank level with PID_Compact, in SCL (S7-1200/1500).\n   Choose Simulations > Tank level, then move the setpoint knob and the outlet. *)\n\"Level\" := INT_TO_REAL(%IW64) / 27648.0 * 100.0;        // 0-27648 -> 0-100 %\n\"Setpoint\" := INT_TO_REAL(%IW66) / 27648.0 * 100.0;\n\n\"LevelPID\".PID_Compact(Setpoint := \"Setpoint\", Input := \"Level\", Output => \"Valve\");\n%QW64 := REAL_TO_INT(\"Valve\" / 100.0 * 27648.0);         // 0-100 % -> 0-27648\n\n// High level alarm with 5 % hysteresis.\nIF \"Level\" > 90.0 THEN\n    \"Alarm\" := TRUE;\nELSIF \"Level\" < 85.0 THEN\n    \"Alarm\" := FALSE;\nEND_IF;\n"
    }
  ],
  "tags": {
