  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "Main",
      "language": "ST",
      "source": "// Count cars in and out; raise a barrier for a waiting car (the entry only when there is room),\n// lower it once the car has passed the beam.\nIF %I0.0 AND Count < 10 THEN EntryUp := TRUE; END_IF;\nIF EntryPass AND NOT %I0.1 THEN                  // the car has just cleared the entry beam\n    EntryUp := FALSE;\n    Count := Count + 1;\nEND_IF;\nEntryPass := %I0.1;\nIF %I0.2 THEN ExitUp := TRUE; END_IF;\nIF ExitPass AND NOT %I0.3 THEN\n    ExitUp := FALSE;\n    Count := Count - 1;\nEND_IF;\nExitPass := %I0.3;\n%Q0.0 := EntryUp;\n%Q0.1 := ExitUp;\n%Q0.2 := Count >= 10;                            // FULL\n%QW4 := INT_TO_BCD(MAX(10 - Count, 0));          // free spaces\n"
    }
  ],
  "tags": {
    "Count": {
      "type": "DINT",
      "value": 3
    },
    "EntryUp": {
      "type": "BOOL"
