{
  "format": "plcyard",
  "version": 1,
  "profile": "plcyard",
  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "MainRoutine",
      "language": "ST",
      "source": "// Switch 1 or 2 picks recipe 1 or 2 (0 otherwise); button 0 starts the batch.\nSel := 0;\nIF %I0.1 THEN Sel := 1; END_IF;\nIF %I0.2 THEN Sel := 2; END_IF;\nIF %I0.0 AND NOT Busy THEN Busy := TRUE; END_IF;\nFill.TON(IN := Busy, PRE := Recipes[Sel].FillTime);\nMix.TON(IN := Fill.DN, PRE := Recipes[Sel].MixTime);\nIF Mix.DN THEN Busy := FALSE; END_IF;\n%Q0.0 := Busy AND NOT Fill.DN;      // filling valve\n%Q0.1 := Fill.DN AND NOT Mix.DN;     // mixer\n%Q0.2 := %I0.1;           // recipe lamps\n%Q0.3 := %I0.2;\n"
    }
  ],
