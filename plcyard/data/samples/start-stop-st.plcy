{
  "format": "plcyard",
  "version": 1,
  "profile": "plcyard",
  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "MainRoutine",
      "language": "ST",
      "source": "// Start/stop with seal-in, in structured text.\n// Start: NO pushbutton on %I0.0. Stop: NC on %I0.1 (TRUE when not pressed).\nMotor := (%I0.0 OR Motor) AND %I0.1;\n%Q0.0 := Motor;\n\n// Running light 2 s after the motor starts.\nDelay.TON(IN := Motor, PT := T#2s);\n%Q0.1 := Delay.Q;\n\n// Stopped light.\n%Q0.2 := NOT Motor;\n"
    }
  ],
  "tags": {
    "Motor": {
      "type": "BOOL"
    },
    "Delay": {
      "type": "TIMER"
    }
  },
  "symbols": {
    "Motor": "Conveyor motor",
    "%I0.1": "Stop (NC)",
    "Delay": "Running light delay"
  }
}
