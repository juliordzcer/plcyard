        {
          "text": "XIC,Timers[0].DN TON,Timers[1],2000",
          "comment": ""
        },
        {
          "text": "XIC,Timers[0].TT OTE,%Q0.0",
          "comment": "Lamp on while Timers[0] is timing."
        },
        {
          "text": "XIC,Timers[0].DN CTU,Counters[0],5",
          "comment": "Counts complete cycles."
        },
        {
          "text": "XIC,Counters[0].DN OTE,%Q0.1",
          "comment": "After 5 cycles %Q0.1 turns on."
        },
        {
          "text": "XIC,%I0.1 RES,Counters[0]",
          "comment": "%I0.1 resets the counter."
        }
