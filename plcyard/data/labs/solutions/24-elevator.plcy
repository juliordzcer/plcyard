{
  "format": "plcyard",
  "version": 1,
  "profile": "plcyard",
  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "Main",
      "language": "LD",
      "rungs": [
        {
          "text": "BST,1 XIC,%I0.0 NXB,1 XIC,%I0.3 BND,1 OTL,Call1",
          "comment": "Remember a call for floor 1."
        },
        {
          "text": "BST,1 XIC,%I0.1 NXB,1 XIC,%I0.4 BND,1 OTL,Call2",
          "comment": "Remember a call for floor 2."
        },
        {
          "text": "BST,1 XIC,%I0.2 NXB,1 XIC,%I0.5 BND,1 OTL,Call3",
          "comment": "Remember a call for floor 3."
        },
        {
          "text": "XIC,%I0.6 MOV,1,Floor",
          "comment": "The last floor the car was at."
        },
        {
          "text": "XIC,%I0.7 MOV,2,Floor",
          "comment": ""
        },
        {
          "text": "XIC,%I1.0 MOV,3,Floor",
          "comment": ""
        },
        {
          "text": "BST,1 XIC,%I0.6 NXB,1 XIC,%I0.7 NXB,1 XIC,%I1.0 BND,1 OTE,AtFloor",
          "comment": "Level with a floor."
        },
        {
          "text": "XIC,AtFloor BST,1 EQU,Floor,1 XIC,Call1 NXB,1 EQU,Floor,2 XIC,Call2 NXB,1 EQU,Floor,3 XIC,Call3 BND,1 OTE,Here",
          "comment": "A call at this floor."
        },
        {
          "text": "BST,1 LES,Floor,2 XIC,Call2 NXB,1 LES,Floor,3 XIC,Call3 BND,1 OTE,Above",
          "comment": "A call further up."
        },
        {
          "text": "BST,1 GRT,Floor,2 XIC,Call2 NXB,1 GRT,Floor,1 XIC,Call1 BND,1 OTE,Below",
          "comment": "A call further down."
        },
        {
          "text": "EQU,State,0 XIC,Here MOV,1,State",
          "comment": "Idle: a call here opens the door…"
        },
        {
          "text": "EQU,State,0 XIC,Above MOV,3,State",
          "comment": "…else go up…"
        },
        {
          "text": "EQU,State,0 XIC,Below MOV,4,State",
          "comment": "…else go down."
        },
        {
          "text": "EQU,State,1 XIC,%I1.1 BST,1 EQU,Floor,1 OTU,Call1 NXB,1 EQU,Floor,2 OTU,Call2 NXB,1 EQU,Floor,3 OTU,Call3 NXB,1 MOV,2,State BND,1",
          "comment": "Open at the floor: the call is served."
        },
        {
          "text": "EQU,State,2 XIC,Dwell.DN XIC,%I1.3 MOV,5,State",
          "comment": "Open 2 s, then close when the doorway is clear."
        },
        {
          "text": "EQU,State,5 XIO,%I1.3 MOV,1,State",
          "comment": "Someone in the doorway: open again."
        },
        {
          "text": "EQU,State,5 XIC,%I1.2 MOV,0,State",
          "comment": "Closed: idle."
        },
        {
          "text": "BST,1 EQU,State,3 NXB,1 EQU,State,4 BND,1 XIC,Here MOV,1,State",
          "comment": "Travelling: stop at a called floor."
        },
        {
          "text": "EQU,State,2 TON,Dwell,2000",
          "comment": ""
        },
        {
          "text": "EQU,State,3 XIC,%I1.2 XIC,%I1.4 OTE,%Q0.0",
          "comment": "Up, only with the door closed, not past the top."
        },
        {
          "text": "EQU,State,4 XIC,%I1.2 XIC,%I1.5 OTE,%Q0.1",
          "comment": "Down."
        },
        {
          "text": "EQU,State,1 OTE,%Q0.2",
          "comment": "Door open."
        },
        {
          "text": "EQU,State,5 XIC,%I1.3 OTE,%Q0.3",
          "comment": "Door close, never on someone."
        },
        {
          "text": "EQU,Floor,1 OTE,%Q0.4",
          "comment": "Position lamps."
        },
        {
          "text": "EQU,Floor,2 OTE,%Q0.5",
          "comment": ""
        },
        {
          "text": "EQU,Floor,3 OTE,%Q0.6",
          "comment": ""
        }
      ],
      "end_comment": ""
    }
  ],
  "tags": {
    "Call1": {
      "type": "BOOL"
    },
    "Call2": {
      "type": "BOOL"
    },
    "Call3": {
      "type": "BOOL"
    },
    "Floor": {
      "type": "DINT",
      "value": 1
    },
    "AtFloor": {
      "type": "BOOL"
    },
    "Here": {
      "type": "BOOL"
    },
    "Above": {
      "type": "BOOL"
    },
    "Below": {
      "type": "BOOL"
    },
    "State": {
      "type": "DINT"
    },
    "Dwell": {
      "type": "TIMER"
    }
  },
  "symbols": {}
}
