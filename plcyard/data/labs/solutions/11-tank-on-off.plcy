      "title": "Main",
      "language": "LD",
      "rungs": [
        {
          "text": "BST,1 XIC,%I0.0 NXB,1 XIC,%Q0.1 BND,1 XIC,%I0.1 OTE,%Q0.1",
          "comment": "Run: Start seals in, Stop (NC) breaks it."
        },
        {
          "text": "XIC,%Q0.1 LES,%IW64,11059 OTL,Bits[0].0",
          "comment": "Below 40 % (6553 of 16383): pump on."
        },
        {
          "text": "GRT,%IW64,16589 OTU,Bits[0].0",
          "comment": "Above 60 %: pump off. Between the two the pump keeps its state (hysteresis)."
        },
        {
          "text": "XIO,%Q0.1 OTU,Bits[0].0",
          "comment": "Stopped: pump off."
        },
        {
          "text": "XIC,%Q0.1 XIC,Bits[0].0 OTE,%Q0.0",
          "comment": ""
        },
        {
          "text": "XIC,%I0.2 OTE,%Q0.2",
          "comment": "High alarm follows the high level switch."
        }
      ],
      "end_comment": ""
    }
  ],
