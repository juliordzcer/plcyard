  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "Main",
      "language": "LD",
      "rungs": [
        {
          "text": "BST,1 XIC,%I0.0 NXB,1 XIC,On BND,1 XIC,%I0.1 OTE,On",
          "comment": "On seals in, Off (NC) breaks it."
        },
        {
          "text": "XIC,On OTE,%Q0.0",
          "comment": "Fan."
        },
        {
          "text": "BST,1 SCP,%IW64,0,27648,0,50,Room NXB,1 SCP,%IW66,0,27648,0,50,Setpoint BND,1",
          "comment": "Room and setpoint in °C."
        },
        {
          "text": "PID,Climate,Room,Demand,Setpoint",
          "comment": "One loop: -100 % full cooling … +100 % full heating."
        },
        {
          "text": "BST,1 XIO,On NXB,1 XIO,%I0.3 BND,1 MOV,0.0,Demand",
          "comment": "No airflow, no heating or cooling."
        },
        {
          "text": "GRT,Demand,0.0 MUL,Demand,276.48,%QW64",
          "comment": "Heater: the positive part."
        },
        {
          "text": "LEQ,Demand,0.0 MOV,0,%QW64",
          "comment": ""
        },
        {
          "text": "LES,Demand,0.0 MUL,Demand,-276.48,%QW66",
          "comment": "Cooler: the negative part."
        },
        {
          "text": "GEQ,Demand,0.0 MOV,0,%QW66",
          "comment": ""
        },
        {
          "text": "GRT,Demand,1.0 OTE,%Q0.1",
          "comment": "Heating lamp."
        },
        {
          "text": "LES,Demand,-1.0 OTE,%Q0.2",
          "comment": "Cooling lamp."
        }
      ],
      "end_comment": ""
    }
  ],
