      "language": "ST",
      "source": "// Raw counts 0-27648 to percent and back.\nLevel := INT_TO_REAL(%IW64) / 276.48;\nLevelPID.PID(PV := Level, SP := INT_TO_REAL(%IW66) / 276.48, CV => Valve);\n%QW64 := REAL_TO_INT(Valve * 276.48);\n"
    }
