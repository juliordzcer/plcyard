{
  "format": "plcyard",
  "version": 1,
  "profile": "plcyard",
  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "Main",
      "language": "ST",
      "source": "// Two pumps take turns (the lead changes every cycle); the second helps above the high level;\n// a failed pump is replaced by the other; alarm on overflow level or a fault, reset by the button.\nIF NOT P1On AND NOT P2On AND %I0.3 THEN          // a new cycle at the start level\n    Lead := 3 - Lead;\n    IF Lead = 1 AND NOT %I0.6 OR %I0.7 THEN P1On := TRUE; ELSE P2On := TRUE; END_IF;\nEND_IF;\nIF %I0.4 THEN                                    // high level: both\n    P1On := NOT %I0.6;\n    P2On := NOT %I0.7;\nEND_IF;\nIF %I0.6 AND P1On THEN P1On := FALSE; P2On := NOT %I0.7; END_IF;\nIF %I0.7 AND P2On THEN P2On := FALSE; P1On := NOT %I0.6; END_IF;\nIF NOT %I0.2 OR NOT %I0.1 THEN                   // low level or Stop: both off\n    P1On := FALSE;\n    P2On := FALSE;\nEND_IF;\n%Q0.0 := P1On;\n%Q0.1 := P2On;\nIF %I0.5 OR %I0.6 OR %I0.7 THEN Alarm := TRUE; END_IF;\nIF %I0.0 AND NOT %I0.5 AND NOT %I0.6 AND NOT %I0.7 THEN Alarm := FALSE; END_IF;\n%Q0.2 := Alarm;\n"
    }
  ],
  "tags": {
    "P1On": {
      "type": "BOOL"
    },
    "P2On": {
      "type": "BOOL"
    },
    "Lead": {
      "type": "DINT",
      "value": 2
    },
    "Alarm": {
      "type": "BOOL"
    }
  },
  "symbols": {
    "%I0.0": "Reset alarm (PB)",
    "%I0.1": "Stop (NC, PB)"
  }
