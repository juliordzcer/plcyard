  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "MainRoutine",
      "language": "LD",
      "rungs": [
        {
          "text": "XIC,FirstScan MOV,4.0,LevelPID.KP MOV,15.0,LevelPID.TI",
          "comment": "Tuning, set once on the first scan: gain 4, integral time 15 s."
        },
        {
          "text": "DIV,%IW64,276.48,Level",
          "comment": "Level: raw 0-27648 to 0-100 %."
        },
        {
          "text": "DIV,%IW66,276.48,LevelPID.SP",
          "comment": "Setpoint from the knob."
        },
        {
          "text": "PID,LevelPID,Level,ValveOut",
          "comment": ""
        },
        {
          "text": "MUL,ValveOut,276.48,%QW64",
          "comment": "Valve: 0-100 % to raw 0-27648."
        }
      ],
      "end_comment": ""
    }
  ],
  "tags": {
