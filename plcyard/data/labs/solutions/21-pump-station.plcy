{
  "format": "plcyard",
  "version": 1,
  "profile": "plcyard",
  "programs": [
    {
      "number": 2,
      "kind": "LAD",
      "title": "Main",
      "language": "LD",
      "rungs": [
        {
          "text": "XIO,P1On XIO,P2On XIC,%I0.3 OTE,NewCycle",
          "comment": "No pump runs and the start level is reached: a new cycle."
        },
        {
          "text": "XIC,NewCycle SUB,3,Lead,Lead",
          "comment": "The other pump leads this cycle."
        },
        {
          "text": "XIC,NewCycle BST,1 EQU,Lead,1 XIO,%I0.6 NXB,1 XIC,%I0.7 BND,1 OTL,P1On",
          "comment": "Pump 1 if it leads and is healthy, or if pump 2 is faulty…"
        },
        {
          "text": "XIC,NewCycle XIO,P1On OTL,P2On",
          "comment": "…otherwise pump 2."
        },
        {
          "text": "XIC,%I0.4 XIO,%I0.6 OTL,P1On",
          "comment": "High level: every healthy pump runs."
        },
        {
          "text": "XIC,%I0.4 XIO,%I0.7 OTL,P2On",
          "comment": ""
        },
        {
          "text": "XIC,%I0.6 XIC,P1On BST,1 OTU,P1On NXB,1 XIO,%I0.7 OTL,P2On BND,1",
          "comment": "Pump 1 failed: pump 2 takes over."
        },
        {
          "text": "XIC,%I0.7 XIC,P2On BST,1 OTU,P2On NXB,1 XIO,%I0.6 OTL,P1On BND,1",
          "comment": "Pump 2 failed: pump 1 takes over."
        },
        {
          "text": "BST,1 XIO,%I0.2 NXB,1 XIO,%I0.1 BND,1 BST,1 OTU,P1On NXB,1 OTU,P2On BND,1",
          "comment": "Low level or Stop: both off."
        },
        {
          "text": "XIC,P1On OTE,%Q0.0",
          "comment": "Pump 1."
        },
        {
          "text": "XIC,P2On OTE,%Q0.1",
          "comment": "Pump 2."
        },
        {
          "text": "BST,1 XIC,%I0.5 NXB,1 XIC,%I0.6 NXB,1 XIC,%I0.7 BND,1 OTL,Alarm",
          "comment": "Alarm on overflow level or a fault…"
        },
        {
          "text": "XIC,%I0.0 XIO,%I0.5 XIO,%I0.6 XIO,%I0.7 OTU,Alarm",
          "comment": "…reset only once they are gone."
        },
        {
          "text": "XIC,Alarm OTE,%Q0.2",
          "comment": "Alarm lamp."
        }
      ],
      "end_comment": ""
    }
  ],
  "tags": {
    "P1On": {
      "type": "BOOL"
    },
    "P2On": {
      "type": "BOOL"
    },
    "Lead": {
      "type": "DINT",
      "value": 2
    },
    "Alarm": {
      "type": "BOOL"
    },
    "NewCycle": {
      "type": "BOOL"
    }
  },
  "symbols": {
    "%I0.0": "Reset alarm (PB)",
    "%I0.1": "Stop (NC, PB)"
  }
}
